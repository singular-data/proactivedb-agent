{
  "SqlMonitor": {
    "ApiBaseUrl": "https://your-proactivedb-backend",
    "ApiKey": "pdb_YOUR_API_KEY_HERE",
    "PollIntervalMinutes": 5,
    "MaxRowsPerTable": 100,
    "MaxParallelTables": 4,
    "MaxParallelInstances": 0,
    "UseProxy": false,
    "ProxyUrl": "",
    "ProxyUsername": "",
    "ProxyPassword": "",
    "ProxyDomain": "",
    "Instances": [
      {
        "Name": "sql-server-01",
        "ConnectionString": "Data Source=YOUR_SQL_SERVER;Database=YOUR_DB;User ID=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=True;Connect Timeout=30",
        "Tables": [
          {
            "TableName": "mnt.your_table",
            "KeyColumn": "id",
            "Columns": ""
          }
        ]
      },
      {
        "Name": "sql-server-02",
        "ConnectionString": "Data Source=YOUR_SECOND_SQL_SERVER;Database=YOUR_DB;User ID=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=True;Connect Timeout=30",
        "MaxParallelTables": 2,
        "Tables": [
          {
            "TableName": "mnt.your_table",
            "KeyColumn": "id"
          }
        ]
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "SourceName": "ProactiveDB SQL Monitor",
      "LogName": "Application",
      "LogLevel": {
        "Default": "Information"
      }
    }
  }
}
